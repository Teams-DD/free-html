# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Turso SQLite Database Credentials
# Get these from your Turso dashboard: https://turso.tech
TURSO_DATABASE_URL="libsql://your-database-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token"

# Note: Cloudflare R2 credentials are fully configured and managed securely
# from the Admin Panel (/vcon -> Cloudflare R2 tab) and stored in Turso SQLite settings.


# Admin Panel Security Session Secret
# Admin credentials are not hardcoded. On first visit to /vcon/, if no admin user
# exists in the Turso database, an admin creation screen prompts you to register your admin user.
ADMIN_SECRET="secure_random_admin_session_secret"
